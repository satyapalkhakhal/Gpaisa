# PostgreSQL (server-only). For local dev, a throwaway container works:
#   docker run -d --name gpaisa-pg -e POSTGRES_PASSWORD=localtest -e POSTGRES_DB=gpaisa -p 127.0.0.1:54329:5432 postgres:17-alpine
#   then apply db/migrations/*.sql in order with psql.
DATABASE_URL=postgresql://postgres:localtest@127.0.0.1:54329/gpaisa

# Admin auth
ADMIN_USERNAME=your-admin-username
ADMIN_PASSWORD_HASH=your-bcrypt-password-hash
# Optional extra admins: comma-separated username:bcrypt-hash pairs
# ADMIN_EXTRA_USERS=editor@example.com:$2b$10$hash-one
JWT_SECRET=a-long-random-secret-string

# Cloudinary (image uploads)
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Resend (contact form email)
RESEND_API_KEY=your-resend-api-key
