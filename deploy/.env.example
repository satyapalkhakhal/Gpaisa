# Production secrets for deploy/docker-compose.yml. Copy to deploy/.env on the VM
# (chmod 600) — deploy/.env is gitignored and must never be committed.

# Database (generate with: openssl rand -hex 24)
POSTGRES_PASSWORD=change-me
# Used only by `next build` (prerendering), which runs on the host network:
BUILD_DATABASE_URL=postgresql://gpaisa:change-me@127.0.0.1:5432/gpaisa
# Optional: connections per app instance (default 5)
# DATABASE_POOL_MAX=5

# Admin auth. Wrap the bcrypt hash in SINGLE quotes and drop any \ escapes:
# Docker Compose treats $ as a variable reference, which would corrupt the hash.
ADMIN_USERNAME=your-admin-username
ADMIN_PASSWORD_HASH='$2b$10$your-bcrypt-password-hash'
JWT_SECRET=a-long-random-secret-string

# Cloudinary (image uploads)
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Resend (contact form email)
RESEND_API_KEY=your-resend-api-key

# Backups (deploy/backup.sh)
BACKUP_BUCKET=gs://gpaisa-db-backups
